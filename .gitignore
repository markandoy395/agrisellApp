# Local Flutter compile-time configuration. Copy the example and keep the
# project-specific value out of source control.
/supabase.local.json
/assets/config/supabase.local.json
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist

# Local tool state and temporary database output
/android/.kotlin/
/supabase/.branches
/supabase/.temp/
/.tmp_remote_schema.sql
/.baseline_logs/

# Preserved invalid repository metadata from the pre-baseline recovery
/.git_broken_backup/

# Superseded local progress report; the screenshot edition contains its text
/AGRISELL_Application_Progress_Report_June_8_to_July_18_2026.docx

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
