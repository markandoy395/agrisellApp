**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# JavaScript tooling used by local project utilities
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local environment and credential files
.env
.env.*
!.env.example
!.env.*.example
**/key.properties
**/*.jks
**/*.keystore
**/*.p12
**/*.pfx
